# Copy this file to .env and adjust as needed.
# Every value below is also the default baked into producers/core/config.py,
# so an empty .env (or no .env at all) works fine for local dev.

# ----- App -----
APP_ENV=local
LOG_LEVEL=INFO

# ----- Kafka (producers/core/config.py: KafkaSettings) -----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_VIEW_EVENTS=streamcore.video.views
KAFKA_TOPIC_WATCH_EVENTS=streamcore.video.watch_progress
KAFKA_CLIENT_ID=streamcore-producer

# ----- Postgres (producers/core/config.py: PostgresSettings) -----
# These also feed docker-compose.yml's postgres service on first volume init.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamcore
POSTGRES_USER=streamcore
POSTGRES_PASSWORD=change_me_locally

# ----- Producer behavior (producers/core/config.py: ProducerSettings) -----
PRODUCER_EVENTS_PER_SECOND=10
PRODUCER_SIMULATED_USERS=100
PRODUCER_SIMULATED_VIDEOS=50

# ----- ClickHouse (producers/core/config.py: ClickHouseSettings) -----
# dbt's warehouse (see streamcore_dbt/). Port 8123 is the HTTP interface,
# also feeds docker-compose.yml's clickhouse service on first volume init.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=streamcore
CLICKHOUSE_USER=streamcore
CLICKHOUSE_PASSWORD=change_me_locally

# ----- Data quality (producers/core/config.py: DataQualitySettings) -----
DATA_QUALITY_FRESHNESS_THRESHOLD_MINUTES=15
